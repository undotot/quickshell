{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickShell",
  "version": "0.2.0",
  "identifier": "com.quickshell.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickShell",
        "width": 660,
        "height": 430,
        "minWidth": 560,
        "minHeight": 380,
        "resizable": true,
        "center": true,
        "decorations": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzRDkzNzRBMDMwNjJFNzkKUldSNUxnWURTamZaNCs5QnIycVJ5cFIyRUJQS0lGUnRSdTV1RTJlckNmZHhva21zNy9RUHpZNjgK",
      "endpoints": [
        "https://github.com/undotot/quickshell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
