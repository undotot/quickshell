{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickShell",
  "version": "0.1.5",
  "identifier": "com.quickshell.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickShell",
        "width": 380,
        "height": 480,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": false,
        "center": true,
        "decorations": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwOUQ2QjBFOUY5NUJFOUEKUldTYXZwV2ZEbXVkRUF5WS9rVzFlWGlIbElkU2xSbmIvaklPVDR2alBZTFp3OTJiby8yKzUyNGQK",
      "endpoints": [
        "https://github.com/undotot/quickshell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
