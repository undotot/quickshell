{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickShell",
  "version": "0.1.0",
  "identifier": "com.quickshell.desktop",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickShell",
        "width": 380,
        "height": 480,
        "minWidth": 320,
        "minHeight": 300,
        "resizable": false,
        "center": true,
        "decorations": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
